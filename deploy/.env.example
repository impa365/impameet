# IMPA Meet — stack variables (no secrets here: those live in Docker Swarm secrets).
# CLI: copy to deploy/.env and run deploy/scripts/deploy.sh
# Portainer: add each line under "Environment variables" when creating the stack.

# --- Required ---------------------------------------------------------------
# Web address of the platform (DNS A record pointing at this server)
PLATFORM_HOST=meet.example.com
# Address of the media server (another DNS A record pointing at this server)
LIVEKIT_HOST=livekit.example.com
# Public IPv4 of this server (advertised to browsers for audio and video)
SERVER_PUBLIC_IP=203.0.113.10

# --- Optional ---------------------------------------------------------------
# Image version: "latest" follows the main branch; pin a release (e.g. 1.0.0) in production
IMPAMEET_VERSION=latest
# Organization slug served at the root domain (empty: the landing page with sign-up)
DEFAULT_TENANT=
# Traefik already running on this Swarm
TRAEFIK_NETWORK=network_public
TRAEFIK_CERT_RESOLVER=letsencryptresolver
TRAEFIK_ENTRYPOINT=websecure
# "swarm" for Traefik v3, "docker" for Traefik v2 (only used by custom domains)
TRAEFIK_PROVIDER=swarm
# Subnet of docker_gwbridge (check with: docker network inspect docker_gwbridge)
DOCKER_BRIDGE_SUBNET=172.18.0.0/16
LOG_LEVEL=INFO
